{
  "rigid": {
    "word": "rigid",
    "phonetic": "/ˈrɪdʒ.ɪd/",
    "part_of_speech": ["adjective"],
    "meanings": {
      "adjective": [
        {
          "definition": "Unable to bend or be forced out of shape; not flexible.",
          "example": "A rigid plastic container."
        },
        {
          "definition": "Not able to be changed or adapted.",
          "example": "The company has very rigid rules."
        }
      ]
    },
    "synonyms": ["stiff", "firm", "inflexible"],
    "antonyms": ["flexible", "lenient"],
    "usage_examples": ["Rigid discipline."]
  }
}