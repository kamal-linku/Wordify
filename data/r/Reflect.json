{
  "reflect": {
    "word": "reflect",
    "phonetic": "/rɪˈflekt/",
    "part_of_speech": ["verb"],
    "meanings": {
      "verb": [
        {
          "definition": "(of a surface) throw back light, heat, or sound without absorbing it.",
          "example": "The snow reflected the bright sunlight."
        },
        {
          "definition": "Think deeply or carefully about.",
          "example": "He paused to reflect on his next move."
        }
      ]
    },
    "synonyms": ["mirror", "ponder", "consider"],
    "antonyms": ["absorb"],
    "usage_examples": ["Reflect on one's past."]
  }
}